# PostgreSQL
# Use 5433 when Docker Postgres runs alongside local PostgreSQL on Windows (default in docker-compose).
DATABASE_URL=postgresql://resolverun:resolverun@localhost:5433/resolverun

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth (min 32 chars in production)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# API
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Worker / scheduler
WORKER_ID=worker-1
WORKER_POLL_MS=1000
WORKER_HEARTBEAT_MS=5000
WORKER_LEASE_MS=60000
SCHEDULER_INTERVAL_MS=15000
RECOVERY_INTERVAL_MS=30000

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:4000
