generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  HTTP_REQUEST
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  UNKNOWN
  VERIFYING
  CANCELLED
}

enum TriggerType {
  MANUAL
  SCHEDULED
  RETRY
  RECOVERY
}

enum RetryDecision {
  NONE
  SCHEDULED
  BLOCKED
  MANUAL_ONLY
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  jobs         Job[]

  @@map("users")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  description String?
  type        JobType   @default(HTTP_REQUEST)
  configuration Json
  schedule    String?
  enabled     Boolean   @default(true)
  riskLevel   RiskLevel @default(MEDIUM) @map("risk_level")
  nextRunAt   DateTime? @map("next_run_at")
  lastRunAt   DateTime? @map("last_run_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions  Execution[]

  @@index([userId])
  @@index([nextRunAt])
  @@index([enabled, nextRunAt])
  @@index([deletedAt])
  @@map("jobs")
}

model Execution {
  id                    String          @id @default(uuid()) @db.Uuid
  jobId                 String          @map("job_id") @db.Uuid
  status                ExecutionStatus @default(QUEUED)
  triggerType           TriggerType     @map("trigger_type")
  attemptNumber         Int             @default(1) @map("attempt_number")
  maxAttempts           Int             @default(3) @map("max_attempts")
  workerId              String?         @map("worker_id")
  startedAt             DateTime?       @map("started_at")
  finishedAt            DateTime?       @map("finished_at")
  heartbeatAt           DateTime?       @map("heartbeat_at")
  scheduledRetryAt      DateTime?       @map("scheduled_retry_at")
  durationMs            Int?            @map("duration_ms")
  httpStatus            Int?            @map("http_status")
  errorCode             String?         @map("error_code")
  errorMessage          String?         @map("error_message")
  resultSummary         String?         @map("result_summary")
  retryDecision         RetryDecision   @default(NONE) @map("retry_decision")
  retryReason           String?         @map("retry_reason")
  idempotencyKey        String?         @map("idempotency_key")
  scheduleOccurrenceKey String?         @map("schedule_occurrence_key")
  configurationSnapshot Json?           @map("configuration_snapshot")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  job    Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events ExecutionEvent[]

  @@unique([jobId, idempotencyKey])
  @@unique([jobId, scheduleOccurrenceKey])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@index([status, scheduledRetryAt])
  @@map("executions")
}

model ExecutionEvent {
  id          String   @id @default(uuid()) @db.Uuid
  executionId String   @map("execution_id") @db.Uuid
  message     String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_events")
}
