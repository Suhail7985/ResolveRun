{
  "name": "resolverun-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:scheduler": "tsx watch src/scheduler/main.ts",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/main.js",
    "start:scheduler": "node dist/scheduler/main.js",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node dist/seed-demo.js",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.44.0",
    "cron-parser": "^5.0.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.5.0",
    "undici": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
